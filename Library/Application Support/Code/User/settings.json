{
  "files.autoSave": "onFocusChange",
  "workbench.colorTheme": "Light Modern",
  "github.copilot.nextEditSuggestions.enabled": false,
  "github.copilot.enable": { "*": false }, // mostly don't want the completions but don't know how to turn just that off (see above)
  "gitlens.ai.enabled": false,
  "vim.leader": "<space>",
  "vim.foldfix": true,
  "window.autoDetectColorScheme": true,
  "terminal.integrated.scrollback": 10000,
  "vim.normalModeKeyBindingsNonRecursive": [
    { 
    "before": ["<leader>", " "],
    "commands": ["workbench.action.showCommands"]
    },
    // basic editing
    {
      "before": ["v", "v"],
      "after": ["V"],
    },
    {
      "before": ["<leader>", ";", ";"],
      "commands": ["editor.action.commentLine"],
    },

    {
      "before": ["<leader>", "'"],
      "commands": ["terminal.focus"],
    },
    {
      "before": ["<leader>", "f", "s"],
      "commands": ["workbench.action.files.save"],
    },
    {
      "before": ["<leader>", "b", "b"],
      "commands": ["workbench.action.showAllEditorsByMostRecentlyUsed"],
    },
    { 
      "before": ["<leader>", "p", "f"],
      "commands": ["workbench.action.quickOpen"]
    },
    {
      "before": ["<leader>", "<tab>"],
      "commands": ["workbench.action.nextEditor"],
    },
    {
      "before": ["<leader>", "<shift+tab>"],
      "commands": ["workbench.action.previousEditor"],
    },
    {
      "before": ["<leader>", "v"],
      "commands": ["editor.action.smartSelect.expand"],
    },
    {
      "before": ["<leader>", "h"],
      "commands": ["editor.action.showHover"],
    },
    {
      "before": ["<leader>", "f", "y", "y"],
      "commands": ["copyFilePath"],
    },
    {
      "before": ["<leader>", "t", "l"],
      "commands": ["editor.action.toggleWordWrap"],
    },

    // lsp
    {
      "before": [",", "r", "r"],
      "commands": ["editor.action.rename"],
    },
    {
      "before": [",", "g", "r"],
      "commands": ["editor.action.goToReferences"],
    },

    // window management
    {
      "before": ["<leader>", "w", "/"],
      "commands": ["workbench.action.splitEditor"],
    },
    {
      "before": ["<leader>", "w", "-"],
      "commands": ["workbench.action.splitEditorDown"],
    },
    {
      "before": ["<leader>", "w", "l"],
      "commands": ["workbench.action.focusRightGroup"],
    },
    {
      "before": ["<leader>", "w", "h"],
      "commands": ["workbench.action.focusLeftGroup"],
    },
    {
      "before": ["<leader>", "w", "j"],
      "commands": ["workbench.action.focusBelowGroup"],
    },
    {
      "before": ["<leader>", "w", "k"],
      "commands": ["workbench.action.focusAboveGroup"],
    },
    {
      "before": ["<leader>", "b", "d"],
      "commands": ["workbench.action.closeActiveEditor"],
    },
    {
      "before": ["<leader>", "g", "o"],
      "commands": ["gitlens.openFileOnRemote"]
    },
    {
      "before": ["<leader>", "/"],
      "commands": ["workbench.view.search"]
    }

  ],
  "vim.visualModeKeyBindingsNonRecursive": [
    {
      "before": ["<leader>", ";", ";"],
      "commands": ["editor.action.commentLine"],
    },
    {
      "before": ["<leader>", "v"],
      "commands": ["editor.action.smartSelect.expand"],
    },
  ],
  "[typescript]": {
  
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "claudeCode.preferredLocation": "panel",
  "gitlens.ai.model": "vscode",
  "gitlens.ai.vscode.model": "copilot:gpt-4.1",
  "chat.disableAIFeatures": true,
  "explorer.confirmDelete": false,
  "git.blame.editorDecoration.enabled": true,
  "editor.accessibilitySupport": "off",
  "chat.useHooks": true,
  "chat.hookFilesLocations": {
    "~/.copilot/hooks": true
  },
  "githubPullRequests.terminalLinksHandler": "github",
  "json.schemaDownload.trustedDomains": {
    "https://developer.microsoft.com/json-schemas/": true,
    "https://json-schema.org/": true,
    "https://json.schemastore.org/": true,
    "https://raw.githubusercontent.com/devcontainers/spec/": true,
    "https://raw.githubusercontent.com/microsoft/vscode/": true,
    "https://schemastore.azurewebsites.net/": true,
    "https://unpkg.com/knip%406/schema.json": true,
    "https://www.schemastore.org/": true
  }
}
